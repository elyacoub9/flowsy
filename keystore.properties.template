# Copy this file to "keystore.properties" (same folder) and fill in your own values.
# keystore.properties is gitignored: never commit it, never share it.
# Use forward slashes in the path, e.g. C:/Users/you/keys/flowsy-release.jks
storeFile=PATH_TO_YOUR_KEYSTORE.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=flowsy
keyPassword=YOUR_KEY_PASSWORD
